# Copy to apps/web/.env for local development. Vite reads it and every VITE_*
# var is validated in packages/env; the Cloudflare vite plugin also hands it to
# the Worker as local dev vars. Nothing here is required to run the site.
# Local URLs are served by portless (https://portless.sh): named HTTPS .localhost
# domains instead of ports.

# --- Client (Vite) ---
# OpenPanel project id. Public by design (the secret half never leaves the
# analytics host). Unset means the analytics script is never injected.
VITE_OPENPANEL_CLIENT_ID=50d69542-4ced-4fbf-b43e-97eb2deca119

# --- Worker ---
# Both set turns on the evlog Axiom drain; without them evlog logs to the
# console. In production they are Worker secrets: `wrangler secret put <name>`.
# AXIOM_TOKEN=
# AXIOM_DATASET=
