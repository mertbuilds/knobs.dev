{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@knobs/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/routeTree.gen.ts", "src/paraglide/**"]
    },
    "@knobs/web#typecheck": {
      "dependsOn": ["@knobs/web#build"]
    }
  }
}
